<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_primary">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp">
        <ImageView
            android:id="@+id/back_tool"
            android:padding="8dp"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_arrow_back" />
        <LinearLayout
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1.0">
            <androidx.cardview.widget.CardView
                android:layout_gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="5dp"
                app:cardCornerRadius="8dp">
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <ImageView
                        android:padding="2dp"
                        android:layout_width="32dp"
                        android:layout_height="30dp"
                        android:src="@drawable/logo" />
                    <TextView
                        android:textSize="16sp"
                        android:gravity="center"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:textColor="@color/text_primary"
                        android:text="@string/downloads" />
                    <ImageView
                        android:padding="2dp"
                        android:layout_width="32dp"
                        android:layout_height="30dp"
                        android:id="@+id/sign_tool"
                        android:src="@drawable/ic_download" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
        <ImageView
            android:id="@+id/menu_tool"
            android:padding="8dp"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_menu" />
    </LinearLayout>

    <EditText
        android:id="@+id/editSearchDownload"
        android:layout_height="56dp"
        android:layout_marginTop="10dp"
        android:layout_width="match_parent"
        android:hint="@string/search_download"
        android:textSize="12sp"
        android:singleLine="true"
        android:textColorHint="@color/text_secondary"
        android:layout_marginHorizontal="5dp"
        android:imeOptions="actionSearch"/>

    <HorizontalScrollView
        android:id="@+id/scrollFilterDownload"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingBottom="6dp"
        android:scrollbars="none"
        android:requiresFadingEdge="horizontal"
        android:fadingEdgeLength="12dp"
        android:clipToPadding="false"
        android:overScrollMode="never">

        <LinearLayout
            android:id="@+id/layoutFilterDownload"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical" />
    </HorizontalScrollView>

    <kawaii.viey.browser.RecyclerViey
        android:id="@+id/recyclerDownload"
        android:requiresFadingEdge="vertical"
        android:fadingEdgeLength="12dp"
        android:clipToPadding="false"
        android:scrollbars="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <TextView
        android:id="@+id/textEmptyDownload"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:textSize="16sp"
        android:visibility="gone"
        android:text="@string/no_download" />
</LinearLayout>